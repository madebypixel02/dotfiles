{
  "autoMemoryEnabled": true,
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run type-check*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(cat*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(rg*)",
      "Bash(grep*)",
      "Bash(wc*)",
      "Bash(echo*)",
      "Bash(pwd)",
      "Bash(which*)",
      "Bash(printenv PATH)",
      "Bash(printenv HOME)",
      "Bash(printenv SHELL)",
      "Bash(printenv USER)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(sudo rm*)",
      "Bash(chmod 777*)",
      "Bash(curl * | bash*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(wget * | bash*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Write(**/.env.staging)",
      "Write(**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cmd=$(printf \"%s\" \"$CLAUDE_TOOL_INPUT\" | jq -r .command 2>/dev/null || echo \"\"); if printf \"%s\\n\" \"$cmd\" | grep -qE \"(rm\\s+-rf|git\\s+push\\s+--force|git\\s+push\\s+-f|curl.*\\|.*bash|wget.*\\|.*bash|dd\\s+if.*of=.*/dev/|mkfs|fdisk|parted|shred)\"; then printf \"BLOCKED: Dangerous command pattern detected: %s\\n\" \"$cmd\" >&2; exit 1; fi'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'file=$(printf \"%s\" \"$CLAUDE_TOOL_INPUT\" | jq -r .filePath 2>/dev/null || echo \"\"); if [ -z \"$file\" ]; then file=$(printf \"%s\" \"$CLAUDE_TOOL_INPUT\" | jq -r .path 2>/dev/null || echo \"\"); fi; if [ -n \"$file\" ]; then ext=\"${file##*.}\"; case \"$ext\" in ts|tsx|js|jsx) npx prettier --write \"$file\" || true ;; py) ruff format \"$file\" || true ;; go) gofmt -w \"$file\" || true ;; rs) rustfmt \"$file\" || true ;; esac; fi'"
          }
        ]
      }
    ]
  }
}
