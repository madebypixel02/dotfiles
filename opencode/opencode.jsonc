{
  "$schema": "https://opencode.ai/config.json",

  // ─── Models ───────────────────────────────────────────────────────────────
  // Override via OPENCODE_MODEL env var or --model flag at runtime
  "model": "github-copilot/claude-sonnet-4.6",
  "small_model": "github-copilot/claude-haiku-4.5",

  // ─── Custom providers ─────────────────────────────────────────────────────
  // Azure OpenAI — set AZURE_OPENAI_API_KEY in your shell environment
  // "provider": {
  //   "azure-openai": {
  //     "name": "Azure OpenAI",
  //     "npm": "@ai-sdk/openai-compatible",
  //     "options": {
  //       "baseURL": "https://YOUR_RESOURCE.openai.azure.com/openai/v1",
  //       "apiKey": "{env:AZURE_OPENAI_API_KEY}"
  //     },
  //     "models": {
  //       "gpt-4.1": { "name": "GPT-4.1", "cost": { "input": 2, "output": 8 } },
  //       "gpt-4.1-mini": { "name": "GPT-4.1-mini", "cost": { "input": 0.4, "output": 1.6 } }
  //     }
  //   }
  // },

  // ─── Agent defaults ───────────────────────────────────────────────────────
  "default_agent": "orchestrator",

  // ─── Sharing & updates ────────────────────────────────────────────────────
  "share": "disabled",
  "autoupdate": "notify",

  // ─── Snapshots & compaction ───────────────────────────────────────────────
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 15000
  },

  // ─── File watcher ─────────────────────────────────────────────────────────
  // Patterns to ignore when watching for file changes in the workspace
  "experimental": {
    "watcher": {
      "ignore": [
        "node_modules",
        "dist",
        ".next",
        "coverage",
        ".turbo",
        ".git",
        "*.log"
      ]
    }
  },

  // ─── Permissions ──────────────────────────────────────────────────────────
  // Rules are evaluated in order; the LAST matching rule wins.
  // Broad patterns first, narrow overrides last.
  "permission": {
    // Read-only tools: allow by default (agents are browsers, not writers)
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",

    // File edits: ask for confirmation on every write
    "edit": "ask",

    // External directory access: project workspace is open; home/system dirs are locked
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "~/dotfiles/**":         "allow",
      "~/projects/**":         "allow",
      "~/.ssh/**":             "deny",
      "~/.gnupg/**":           "deny",
      "~/.aws/**":             "deny",
      "~/.kube/**":            "deny",
      "/etc/**":               "deny",
      "/var/**":               "deny",
      "/usr/**":               "deny",
      "*":                     "ask"
    },

    // Bash: safe read/nav commands allowed; destructive or network ops need approval
    "bash": {
      // Navigation & inspection (allow)
      "ls *":                       "allow",
      "ls":                         "allow",
      "pwd":                        "allow",
      "echo *":                     "allow",
      "cat *":                      "allow",
      "head *":                     "allow",
      "tail *":                     "allow",
      "wc *":                       "allow",
      "diff *":                     "allow",
      "which *":                    "allow",
      "type *":                     "allow",
      "env":                        "allow",
      "printenv *":                 "allow",

      // Git read operations (allow)
      // Use trailing-space + wildcard to match both bare and flag-bearing variants.
      "git status":                 "allow",
      "git status *":               "allow",
      "git log":                    "allow",
      "git log *":                  "allow",
      "git diff":                   "allow",
      "git diff *":                 "allow",
      "git show":                   "allow",
      "git show *":                 "allow",
      "git branch":                 "allow",
      "git branch *":               "allow",
      "git remote":                 "allow",
      "git remote *":               "allow",
      "git stash list":             "allow",
      "git rev-parse *":            "allow",
      "git describe *":             "allow",
      "git shortlog *":             "allow",

      // Git write operations (ask — require human review)
      "git add *":                  "ask",
      "git commit *":               "ask",
      "git push *":                 "ask",
      "git merge *":                "ask",
      "git rebase *":               "ask",
      "git reset *":                "ask",
      "git checkout *":             "ask",
      "git switch *":               "ask",
      "git stash *":                "ask",
      "git tag *":                  "ask",

      // Package managers — install/run (ask)
      "npm install *":              "ask",
      "npm run *":                  "ask",
      "pnpm install *":             "ask",
      "pnpm run *":                 "ask",
      "pnpm add *":                 "ask",
      "yarn add *":                 "ask",
      "yarn *":                     "ask",
      "bun install *":              "ask",
      "bun add *":                  "ask",
      "bun run *":                  "ask",

      // Build & test runners (ask)
      "npx *":                      "ask",
      "pnpm exec *":                "ask",
      "pnpm dlx *":                 "ask",
      "jest *":                     "ask",
      "vitest *":                   "ask",
      "playwright *":               "ask",

      // Docker (ask — can pull images and spawn containers)
      "docker *":                   "ask",
      "docker-compose *":           "ask",

      // Destructive filesystem ops (deny)
      "rm -rf *":                   "deny",
      "rm -fr *":                   "deny",
      "rm -r /*":                   "deny",
      "rmdir *":                    "deny",
      "shred *":                    "deny",
      "truncate *":                 "deny",
      "> /etc/*":                   "deny",
      "> /var/*":                   "deny",

      // System directory inspection via bash (deny — external_directory rules
      // only cover read/write/edit tools, not bash; these fill the gap)
      "ls /etc":                    "deny",
      "ls /etc/*":                  "deny",
      "ls /etc *":                  "deny",
      "ls /var":                    "deny",
      "ls /var/*":                  "deny",
      "ls /var *":                  "deny",
      "ls /usr":                    "deny",
      "ls /usr/*":                  "deny",
      "ls /usr *":                  "deny",
      "cat /etc/*":                 "deny",
      "cat /var/*":                 "deny",
      "cat /usr/*":                 "deny",

      // Privilege escalation (deny)
      "sudo *":                     "deny",
      "su *":                       "deny",
      "chmod 777 *":                "deny",
      "chown *":                    "deny",

      // Network / secrets exfiltration (deny)
      "curl * | bash":              "deny",
      "wget * | bash":              "deny",
      "curl * | sh":                "deny",
      "wget * | sh":                "deny",
      "ssh *":                      "deny",
      "scp *":                      "deny",
      "nc *":                       "deny",
      "netcat *":                   "deny",

      // Secret access (deny)
      "cat ~/.ssh/*":               "deny",
      "cat ~/.gnupg/*":             "deny",
      "cat ~/.aws/*":               "deny",
      "cat ~/.kube/*":              "deny",
      "cat /etc/passwd":            "deny",
      "cat /etc/shadow":            "deny",

      // Catch-all: anything not matched above requires approval
      "*": "ask"
    }
  },

  // ─── Formatters ───────────────────────────────────────────────────────────
  // Schema: each key is a formatter name; value is { command, extensions }.
  // command receives the file path appended as the final argument by OpenCode.
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write"],
      "extensions": [
        ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs",
        ".json", ".jsonc", ".yaml", ".yml",
        ".css", ".scss", ".html", ".md", ".mdx"
      ]
    }
  },

  // ─── MCP Servers ──────────────────────────────────────────────────────────
  //
  // TIERS:
  //   All servers disabled by default — enable per-project in local opencode.jsonc
  //
  // SECURITY RULES (enforced here):
  //   1. All tokens come from env vars — never hardcoded
  //   2. Remote servers preferred over local npx (no supply-chain risk)
  //   3. High-trust servers (GitHub write, DB) disabled by default
  //   4. Destructive tool patterns denied in the permission block above
  //   5. Context7 and Sentry are zero-trust (read-only, no access to your infra)
  //
  "mcp": {

    // ── AVAILABLE: zero-trust, read-only, no credentials needed ────────────────

    // Context7 — live, version-specific library docs. Eliminates hallucinated
    // APIs. Use by adding "use context7" to any prompt, or add to AGENTS.md:
    // "Always use Context7 when writing code that uses third-party libraries."
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },

    // Semgrep — SAST security scanning. Free remote endpoint, no auth needed
    // for basic scans. Tools: security_check, semgrep_scan, get_abstract_syntax_tree
    // Set SEMGREP_APP_TOKEN for AppSec Platform findings integration.
    "semgrep": {
      "type": "remote",
      "url": "https://mcp.semgrep.ai/mcp",
      "enabled": false
    },

    // ── AVAILABLE: low-trust, credentials via env vars ─────────────────────────

    // GitHub — PRs, issues, Actions CI logs, code scanning, Dependabot.
    // The single most valuable MCP for code-centric teams.
    // Toolsets (add GITHUB_TOOLSETS env var to restrict): repos, issues,
    // pull_requests, actions, code_security, discussions, notifications
    // Scope PAT to: repo, read:org, read:user (minimum)
    // Full write PAT needed for: creating PRs, commenting, merging
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },

    // Sentry — error tracking: issues, traces, stack traces.
    // Switch to local npx for self-hosted: see commented block below.
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false
    },

    // Playwright — browser automation via accessibility tree (no vision model).
    // Enable for UI debugging, E2E test writing, scraping internal dashboards.
    // SECURITY: browser can reach any URL your network allows. Disable when not needed.
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": false,
      "timeout": 30000
    },

    // ── DISABLED: enable per-project in your project's opencode.jsonc ─────────

    // GitHub (Docker alternative — more isolated than remote token approach)
    // Uncomment and disable the remote version above if you prefer container isolation
    // "github-docker": {
    //   "type": "local",
    //   "command": ["docker", "run", "-i", "--rm",
    //               "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
    //               "-e", "GITHUB_TOOLSETS=repos,issues,pull_requests,actions",
    //               "ghcr.io/github/github-mcp-server"],
    //   "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}" },
    //   "enabled": false
    // },

    // PostgreSQL — schema inspection + queries. USE READ-ONLY CREDENTIALS.
    // Set DB_DSN=postgresql://readonly_user:pass@host/db in your environment.
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres",
                  "{env:DB_DSN}"],
      "enabled": false
    },

    // Grafana — dashboards, Prometheus/Loki queries, alerts, incidents, OnCall.
    // Set GRAFANA_URL and GRAFANA_SERVICE_ACCOUNT_TOKEN in your environment.
    "grafana": {
      "type": "local",
      "command": ["uvx", "mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "{env:GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_TOKEN}"
      },
      "enabled": false
    },

    // Linear — issues, projects, comments. Official remote server with OAuth.
    // Run `opencode mcp auth linear` to authenticate.
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    },

    // Exa — neural/semantic web search. Better than keyword search for
    // researching library behavior, changelogs, and technical docs.
    // Requires EXA_API_KEY from exa.ai (paid, ~$0.001/search).
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:EXA_API_KEY}"
      },
      "enabled": false
    },

    // Kubernetes — full kubectl + Helm via MCP. Set ALLOW_ONLY_NON_DESTRUCTIVE_TOOLS
    // for production cluster access.
    "kubernetes": {
      "type": "local",
      "command": ["npx", "mcp-server-kubernetes"],
      "environment": {
        "ALLOW_ONLY_NON_DESTRUCTIVE_TOOLS": "true"
      },
      "enabled": false
    },

    // Cloudflare — Workers, KV, R2, D1, observability, audit logs.
    // Multiple Cloudflare-specific endpoints; add whichever your stack uses.
    // Requires CLOUDFLARE_API_TOKEN scoped per service.
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CLOUDFLARE_API_TOKEN}"
      },
      "enabled": false
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:CLOUDFLARE_API_TOKEN}"
      },
      "enabled": false
    },

    // Figma — expose design layouts to the agent for component code generation.
    // Requires FIGMA_API_KEY (free Personal Access Token from figma.com).
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp"],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "enabled": false
    },

    // Slack — post to channels, read messages, search history.
    // SECURITY: HIGH trust — scopes channel read history. Restrict bot scopes.
    "slack": {
      "type": "local",
      "command": ["npx", "-y", "@zencoderai/slack-mcp-server"],
      "environment": {
        "SLACK_BOT_TOKEN": "{env:SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "{env:SLACK_TEAM_ID}"
      },
      "enabled": false
    },

    // Sentry self-hosted — use instead of remote sentry block above
    // "sentry-self-hosted": {
    //   "type": "local",
    //   "command": ["npx", "@sentry/mcp-server@latest",
    //               "--host={env:SENTRY_HOST}",
    //               "--access-token={env:SENTRY_ACCESS_TOKEN}"],
    //   "enabled": false
    // },

    // Internal tools — replace URL with your organisation's internal MCP server
    "internal-tools": {
      "type": "remote",
      "url": "https://mcp.internal.example.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:INTERNAL_MCP_TOKEN}"
      },
      "enabled": false
    }
  },

  // ─── Plugins ──────────────────────────────────────────────────────────────
  "plugin": [
    "~/.config/opencode/plugins/audit-logger.ts",
    "~/.config/opencode/plugins/secret-guard.ts",
    "~/.config/opencode/plugins/context-injector.ts",
    "~/.config/opencode/plugins/quality-gate.ts",
    "~/.config/opencode/plugins/humanizer-hook.ts",
    "~/.config/opencode/plugins/caveman-guard.ts"
  ],

  // ─── Instruction files ────────────────────────────────────────────────────
  // Loaded as system context for every session
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/docs/ai-guidelines.md"
  ]
}
